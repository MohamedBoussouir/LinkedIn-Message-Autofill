{
  "manifest_version": 3,
  "name": "LinkedIn AI Message Writer (Groq)",
  "version": "2.0",
  "description": "توليد رسائل مخصصة وذكية باستخدام Groq مجاناً",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*", "file://*/*"],
      "js": ["autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}