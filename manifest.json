{
  "manifest_version": 3,
  "name": "LinkedIn AI Message Writer (Groq)",
  "version": "1.0",
  "description": "توليد رسائل لينكد إن مخصصة واحترافية عبر Groq API",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "file://*/*"
      ],
      "js": ["autofill.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}